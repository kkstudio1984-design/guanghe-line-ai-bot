# ===== 必填 =====
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
NOTION_TOKEN=
ANTHROPIC_API_KEY=

# ===== 對外連結（建議填）=====
PRICE_URL=
BOOKING_URL=
MAP_URL=
FOOD_MAP_URL=

# ===== 選填 =====
# 轉真人時推播通知誰（LINE userId，逗號分隔；會算官方帳號訊息則數，留空只寫 Notion）
STAFF_NOTIFY_USER_IDS=
# 轉真人後 AI 暫停幾小時
HANDOFF_PAUSE_HOURS=24
# 圖文選單送出的字（由 LINE 後台關鍵字回應處理，AI 不重複回）
MENU_KEYWORDS=一樓場地,價格方案,怎麼預約,交通停車,美食地圖,找真人,時段,無障礙,設備,工位
# 使用的 Claude 模型
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ===== 預設已填好光合的 Notion ID，通常不用改 =====
# NOTION_KB_DATA_SOURCE_ID=ba4bb142-d9ed-49ab-aed8-59ad5c746235
# NOTION_CUSTOMERS_DATA_SOURCE_ID=e88b68d9-6da8-4e3c-991c-410cfdbe0e13
# NOTION_VOICE_GUIDE_PAGE_ID=3ee0fcad0bc6813aa1a8f9a1be58ad80

# ===== 串接舊 webhook =====
# 官方帳號原本的 webhook（官網）。每則訊息都會原封不動轉一份過去，官網原本的功能照常運作。
LEGACY_WEBHOOK_URL=https://sunlighthub-web.vercel.app/api/line/webhook
# 圖片、檔案交給舊 webhook 處理（有填 LEGACY_WEBHOOK_URL 時預設為 1）
LEGACY_HANDLES_MEDIA=1
